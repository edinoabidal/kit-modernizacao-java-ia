<?xml version="1.0" encoding="UTF-8"?>
<!--
  Testes de caracterização da API do Spring PetClinic REST.
  Projeto independente: não depende do código do PetClinic, só da API HTTP.
  Compila em Java 8 (release 8) e roda igual com o JDK 8 e o JDK 21.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>br.tcc.modernizacao</groupId>
    <artifactId>testes-caracterizacao</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>Testes de caracterização da API do PetClinic REST</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>

        <!-- Versões estáveis, todas compatíveis com Java 8 -->
        <rest-assured.version>5.5.7</rest-assured.version>
        <junit.version>5.14.4</junit.version>
        <hamcrest.version>3.0</hamcrest.version>
        <!-- usado pelo REST Assured para converter o corpo das requisições em JSON -->
        <jackson.version>2.22.4</jackson.version>
        <surefire.version>3.5.6</surefire.version>
        <compiler.version>3.14.1</compiler.version>

        <!-- URL base da API; pode ser trocada com -Dapi.baseUrl=... -->
        <api.baseUrl>http://localhost:9966/petclinic/api</api.baseUrl>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>${rest-assured.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.hamcrest</groupId>
            <artifactId>hamcrest</artifactId>
            <version>${hamcrest.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler.version}</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <systemPropertyVariables>
                        <api.baseUrl>${api.baseUrl}</api.baseUrl>
                    </systemPropertyVariables>
                    <!-- ordem aleatória: comprova que os testes não dependem da ordem -->
                    <runOrder>random</runOrder>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
